# Facebook Chrome Worker
FACEBOOK_CDP_URL=http://127.0.0.1:9223
FACEBOOK_CHROME_PROFILE=$HOME/.hermes/browser-profiles/facebook

# Local project data
GROUPS_FILE=./data/groups.json
POSTS_FILE=./data/posts.json
JOBS_FILE=./data/jobs.json
IMAGES_DIR=./images
LOGS_DIR=./logs
RUNTIME_DIR=./runtime

# Automation behaviour
HEADLESS=false
PREPARE_ONLY=true
DEFAULT_TIMEOUT_MS=30000
UPLOAD_TIMEOUT_MS=120000

# Job locking
LOCK_FILE=./runtime/facebook-post.lock
STALE_LOCK_TIMEOUT_MS=900000
